# Financial Data ETL Pipeline - Environment Configuration
# Copy file này thành .env và điền thông tin

# ===== VNSTOCK API KEY (QUAN TRỌNG!) =====
# Đăng ký tại: https://vnstocks.com/login
# Gói miễn phí: 60 requests/phút (thay vì 20)
VNSTOCK_API_KEY=vnstock_5ae9fb1770068c0b9f20bca0b07fc07d

# ===== DATABASE (PostgreSQL) - Optional =====
# Chỉ cần nếu muốn lưu vào database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ===== PIPELINE SETTINGS =====
# Danh sách mã cổ phiếu (phân cách bằng dấu phẩy)
# Để trống để dùng mặc định (10 mã blue chip)
SYMBOLS=

# Loại báo cáo: quarter (quý) hoặc year (năm)
PERIOD=quarter

# Nguồn dữ liệu vnstock: VCI, TCBS, SSI
DATA_SOURCE=VCI

# Thư mục output
OUTPUT_DIR=./output

# Lưu ra CSV
SAVE_TO_CSV=true

# Lưu vào PostgreSQL (cần cấu hình DB_* ở trên)
SAVE_TO_DB=false

# Ngôn ngữ: vi (Tiếng Việt) hoặc en (English)
LANGUAGE=vi

# Delay giữa các request (giây) - tránh bị rate limit
REQUEST_DELAY=1.5
